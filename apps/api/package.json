    "@nestjs/core": "12.2.0",
    "@nestjs/platform-express": "12.2.0",
    "@node-rs/argon2": "2.2.2",
    "jose": "6.2.13",
    "kysely": "0.29.7",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "prom-client": "15.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.2.0",
    "@testcontainers/postgresql": "12.2.1",
    "@types/express": "5.0.6",
    "@types/pg": "8.23.1",
