# Migration / seed connection (table owner)
DATABASE_OWNER_URL=postgres://kitchos_owner:kitchos_owner_dev@localhost:55432/kitchos
# Runtime connection (restricted role, RLS enforced)
DATABASE_URL=postgres://kitchos_app:kitchos_app_dev@localhost:55432/kitchos
REDIS_URL=redis://localhost:56379
# Dev-only signing secret. Production uses Secrets Manager / an OIDC provider.
AUTH_JWT_SECRET=dev-only-change-me-at-least-32-characters-long
API_PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
